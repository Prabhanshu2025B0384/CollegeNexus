# ===================================================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ===================================================================
# Copy this file to .env in the backend directory or configure these
# environment variables in your deployment dashboard (Render, etc.).
# NEVER commit your actual .env file or real secrets to Git.
# ===================================================================

# Server Port (Render sets this automatically; 8080 is local default)
PORT=8080

# -------------------------------------------------------------------
# SUPABASE S3-COMPATIBLE STORAGE CONFIGURATION
# -------------------------------------------------------------------
# Supabase Project REST API URL (for public image CDN URLs)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase S3-Compatible Endpoint (from Project Settings -> Storage -> S3 Connection)
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3

# Supabase S3 Region (e.g., ap-southeast-1)
SUPABASE_S3_REGION=ap-southeast-1

# S3 Access Key ID (from Supabase Project Settings -> Storage -> S3 Access Keys)
SUPABASE_S3_ACCESS_KEY=YOUR_SUPABASE_S3_ACCESS_KEY

# S3 Secret Access Key (from Supabase Project Settings -> Storage -> S3 Access Keys)
SUPABASE_S3_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY

# Supabase Storage Bucket for event banners
SUPABASE_STORAGE_BUCKET=SDMS

# 4. Supabase PostgreSQL Database Connection URL (Direct or Transaction Pooler URI)
# Standard format: postgresql://postgres.PROJECT_REF:PASSWORD@HOST:PORT/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Alternatively, standard JDBC parameters can be used if preferred:
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_PASSWORD

# -------------------------------------------------------------------
# SECURITY & CORS
# -------------------------------------------------------------------
# JWT Secret for Admin Authentication (32+ chars random string)
JWT_SECRET=YOUR_SUPER_SECRET_KEY_FOR_JWT_TOKEN_SIGNING_32_BYTES_MIN

# Token Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
# Local development: http://localhost:5173
# Production: https://college-nexus-gold.vercel.app
CORS_ALLOWED_ORIGINS=https://college-nexus-gold.vercel.app,http://localhost:5173

# -------------------------------------------------------------------
# INITIAL ADMINISTRATIVE USER
# -------------------------------------------------------------------
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@collegeclub.edu
