# ===================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ===================================================================
# Copy this file to .env in the frontend directory or configure in Vercel.
# NOTE: Only variables prefixed with VITE_ are exposed to the client.
# NEVER put private API secrets, database passwords, or private keys here.
# ===================================================================

# Base URL for the Spring Boot REST API
# Local development:
VITE_API_URL=http://localhost:8080/api

# Production (e.g., when deployed on Render):
# VITE_API_URL=https://your-backend-api.onrender.com/api
