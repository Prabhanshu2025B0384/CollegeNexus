# ===================================================================
# COLLEGE CLUB EVENT MANAGEMENT - ROOT ENVIRONMENT REFERENCE
# ===================================================================
# This file provides a consolidated reference of all environment
# variables used across the frontend, backend, and deployment targets.
#
# DO NOT store real credentials in this file.
# Configure backend/.env and frontend/.env respectively.
# ===================================================================

# -------------------------------------------------------------------
# 1. BACKEND & RENDER ENVIRONMENT VARIABLES
# -------------------------------------------------------------------
PORT=8080

# Supabase S3-Compatible Storage Configuration:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY=YOUR_SUPABASE_S3_ACCESS_KEY
SUPABASE_S3_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY
SUPABASE_STORAGE_BUCKET=SDMS
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT Secret for Signing Admin Tokens
JWT_SECRET=YOUR_SUPER_SECRET_RANDOM_KEY_AT_LEAST_32_BYTES_LONG
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial Admin Credentials
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@collegeclub.edu

# -------------------------------------------------------------------
# 2. FRONTEND & VERCEL ENVIRONMENT VARIABLES (Vite)
# -------------------------------------------------------------------
# Local:
VITE_API_URL=http://localhost:8080/api
# Production on Render:
# VITE_API_URL=https://YOUR_BACKEND_APP.onrender.com/api
